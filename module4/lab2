# Store and Display Student Details Using Files

def add_student():
    name = input("Enter Student Name: ")
    if any(char.isdigit() for char in name):
        print("Invalid Name! Name should not contain numbers.")
        return

    usn = input("Enter USN: ")
    branch = input("Enter Branch: ")
    marks = float(input("Enter Total Marks: "))

    with open("students.txt", "a") as file:
        file.write(f"{usn},{name},{branch},{marks}\n")
    
    print("Student record saved successfully!")

def display_students():
    print("\n================ STUDENT RECORDS ================")
    try:
        with open("students.txt", "r") as file:
            records = file.readlines()
            if not records:
                print("No student records found.")
                return

            print(f"{'USN':<15} {'Name':<20} {'Branch':<10} {'Marks':<10}")
            print("-" * 55)
            for line in records:
                parts = line.strip().split(",")
                if len(parts) == 4:
                    usn, name, branch, marks = parts
                    print(f"{usn:<15} {name:<20} {branch:<10} {marks:<10}")
    except FileNotFoundError:
        print("No records file found. Please add a student first.")
    print("=================================================")

# Main Menu
while True:
    print("\n--- STUDENT FILE MANAGER ---")
    print("1. Add Student Details")
    print("2. Display All Students")
    print("3. Exit")

    choice = input("Enter your choice (1-3): ")

    if choice == "1":
        add_student()
    elif choice == "2":
        display_students()
    elif choice == "3":
        print("Exiting Student Data Manager.")
        break
    else:
        print("Invalid choice! Please select 1, 2, or 3.")